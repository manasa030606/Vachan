# ─────────────────────────────────────────────────────────────
# Vachan frontend environment variables
#
# LOCAL DEVELOPMENT — copy this file to frontend/.env.local:
#     cp frontend/.env.example frontend/.env.local
#
# Variables starting with NEXT_PUBLIC_ are built into the JavaScript that runs in the
# browser — anyone can read them. Never put secrets (API keys, passwords) in them.
# ─────────────────────────────────────────────────────────────

# [local] [browser-visible] Where the browser sends API requests.
# Local: the backend's address (must match PORT in backend/.env).
# Deployed (Vercel): do NOT set it — the site then uses its own /api/* proxy (see BACKEND_URL).
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────
# DEPLOYMENT (set these in Vercel → Project → Settings → Environment Variables,
# not in this file)
# ─────────────────────────────────────────────────────────────

# [deployed] [server-only] Public URL of the deployed backend, without /api and without a
# trailing slash, e.g. https://vachan-api.onrender.com
# Used by next.config.ts to forward /api/* to the backend. Read at BUILD time —
# redeploy after changing it.
# BACKEND_URL=https://your-backend.onrender.com
