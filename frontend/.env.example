# ─────────────────────────────────────────────────────────────
# Vachan frontend environment variables
# Copy this file to frontend/.env.local:
#     cp frontend/.env.example frontend/.env.local
# Variables starting with NEXT_PUBLIC_ are visible in the browser —
# never put secrets (API keys, passwords) in them.
# ─────────────────────────────────────────────────────────────

# URL of the Vachan backend API (must match PORT in backend/.env)
NEXT_PUBLIC_API_URL=http://localhost:4000
