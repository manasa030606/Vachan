# Values for docker-compose.prod.yml. Copy to .env.production (git-ignored) and fill in.
# Generate secrets with:  openssl rand -hex 32
POSTGRES_PASSWORD=change-me-to-a-long-random-password
JWT_SECRET=replace-this-with-64-random-hex-characters
# The address learners open (used for CORS). Behind a domain: https://vachan.example.com
PUBLIC_URL=http://localhost:3000
# AI (server-side only — never in the frontend). Leave empty to run without the tutor/speech.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
# Knowledge-base search (AI tutor) needs ~1 GB RAM for the embedding model.
RAG_ENABLED=true
