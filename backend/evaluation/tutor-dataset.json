    "beginner": 180,
    "elementary": 255,
    "intermediate": 360
  },
  "thresholds": {
    "statusCorrect": 0.85,
    "relevantRetrieval": 0.9,
    "grounded": 0.85,
    "levelRespected": 0.85,
    "nativeWordsFromNotes": 0.9
