# ─────────────────────────────────────────────────────────────
# Vachan backend environment variables — ALL of them are SERVER-ONLY secrets/settings.
#
# LOCAL DEVELOPMENT — copy this file to backend/.env and fill in your own values:
#     cp backend/.env.example backend/.env
# Never commit backend/.env (it is in .gitignore).
#
# DEPLOYMENT — do NOT put real production values in any file. Set them in the hosting
# dashboard (Render → vachan-api → Environment). See docs/DEPLOYMENT.md.
# ─────────────────────────────────────────────────────────────

# development | test | production
#   local: development · deployed (Render): production
#   production = secure (HTTPS-only) cookies, generic 500 error messages, demo user not seeded.
NODE_ENV=development

# Port the Express API listens on. (Not 5000: macOS uses 5000 for AirPlay Receiver.)
#   local: 4000 · deployed: don't set it — Render provides PORT automatically.
PORT=4000

# PostgreSQL connection string:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# local: your own PostgreSQL (value below matches docker-compose.yml / the vachan user).
# deployed: the Neon connection string, e.g.
#   postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#   (use the "direct" string — without "-pooler" — so Prisma migrations work)
DATABASE_URL="postgresql://vachan:vachan_dev_password@localhost:5432/vachan_dev?schema=public"

# Website address(es) allowed to call the API directly from a browser (comma-separated,
# exact, no trailing slash).
#   local: http://localhost:3000 · deployed: your Vercel URL, e.g. https://vachan-xxxx.vercel.app
CORS_ORIGIN=http://localhost:3000

# ── Authentication ───────────────────────────────────────────
# Secret key used to sign login tokens (JWT). REQUIRED, at least 32 characters.
# Generate your own random value (never reuse this example, never commit the real one):
#     openssl rand -hex 32
# Use a DIFFERENT secret for local and deployed. The server refuses to start in production
# with this example value.
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters

# How long a login stays valid: e.g. 7d (days), 12h (hours), 30m (minutes).
JWT_EXPIRES_IN=7d

# Optional, only read by `npm run db:seed`: create the demo account demo@vachan.dev.
# Default: yes in development, no when NODE_ENV=production.
# SEED_DEMO_USER=false

# ── RAG knowledge base (Phase 5) — both optional ─────────────
# The embedding model (multilingual-e5-small, ~130 MB) runs inside the backend: no API key.
# It is downloaded on first use into backend/.cache/models (git-ignored).
#   local: leave unset · deployed: leave unset (downloaded on the first /api/rag request)
# RAG_MODEL_DIR=/absolute/path/to/models
# Set to false to forbid downloading (only use files already in the model folder).
# RAG_ALLOW_DOWNLOAD=true
# RAG search loads the model into memory (~500 MB). Default: on locally, OFF when
# NODE_ENV=production (Render's free plan has only 512 MB). true = force on, false = force off.
# RAG_ENABLED=true
