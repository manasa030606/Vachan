# ─────────────────────────────────────────────────────────────
# Vachan backend environment variables — ALL of them are SERVER-ONLY secrets/settings.
#
# LOCAL DEVELOPMENT — copy this file to backend/.env and fill in your own values:
#     cp backend/.env.example backend/.env
# Never commit backend/.env (it is in .gitignore).
#
# DEPLOYMENT — do NOT put real production values in any file. Set them in the hosting
# dashboard (Render → vachan-api → Environment). See docs/DEPLOYMENT.md.
# ─────────────────────────────────────────────────────────────

# development | test | production
#   local: development · deployed (Render): production
#   production = secure (HTTPS-only) cookies, generic 500 error messages, demo user not seeded.
NODE_ENV=development

# Port the Express API listens on. (Not 5000: macOS uses 5000 for AirPlay Receiver.)
#   local: 4000 · deployed: don't set it — Render provides PORT automatically.
PORT=4000

# PostgreSQL connection string:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# local: your own PostgreSQL (value below matches docker-compose.yml / the vachan user).
# deployed: the Neon connection string, e.g.
#   postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#   (use the "direct" string — without "-pooler" — so Prisma migrations work)
DATABASE_URL="postgresql://vachan:vachan_dev_password@localhost:5432/vachan_dev?schema=public"

# Website address(es) allowed to call the API directly from a browser (comma-separated,
# exact, no trailing slash).
#   local: http://localhost:3000 · deployed: your Vercel URL, e.g. https://vachan-xxxx.vercel.app
CORS_ORIGIN=http://localhost:3000

# ── Authentication ───────────────────────────────────────────
# Secret key used to sign login tokens (JWT). REQUIRED, at least 32 characters.
# Generate your own random value (never reuse this example, never commit the real one):
#     openssl rand -hex 32
# Use a DIFFERENT secret for local and deployed. The server refuses to start in production
# with this example value.
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters

# How long a login stays valid: e.g. 7d (days), 12h (hours), 30m (minutes).
JWT_EXPIRES_IN=7d

# Optional, only read by `npm run db:seed`: create the demo account demo@vachan.dev.
# Default: yes in development, no when NODE_ENV=production.
# SEED_DEMO_USER=false

# ── RAG knowledge base (Phase 5) — both optional ─────────────
# The embedding model (multilingual-e5-small, ~130 MB) runs inside the backend: no API key.
# It is downloaded on first use into backend/.cache/models (git-ignored).
#   local: leave unset · deployed: leave unset (downloaded on the first /api/rag request)
# RAG_MODEL_DIR=/absolute/path/to/models
# Set to false to forbid downloading (only use files already in the model folder).
# RAG_ALLOW_DOWNLOAD=true
# RAG search loads the model into memory (~500 MB). Default: on locally, OFF when
# NODE_ENV=production (Render's free plan has only 512 MB). true = force on, false = force off.
# RAG_ENABLED=true

# ── AI tutor (Phase 6) ───────────────────────────────────────
# The tutor sends the learner's question + the notes found by RAG to an LLM. Free options:
#   gemini (default) — key from https://aistudio.google.com/apikey  (free tier, no card)
#   groq             — key from https://console.groq.com/keys      (free tier)
#   mock             — offline test double used by `npm run test:tutor` (NOT a real AI)
# The key stays in this file on the server: never in frontend/, never in NEXT_PUBLIC_*,
# never in git. Check your setup with:  npm run ai:check -w backend
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# GROQ_API_KEY=
# Optional: another model (default gemini-3.5-flash / llama-3.3-70b-versatile)
# LLM_MODEL=
# Optional (recommended on the free tier): a second model used when the main one is overloaded or
# its daily free quota is used up — each model has its own quota. Used by the tutor, role-play,
# speech-to-text and pronunciation notes. Example: gemini-3.5-flash-lite
# (list: npm run ai:check -w backend -- --models)
# LLM_FALLBACK_MODEL=
# LLM_TIMEOUT_MS=40000
# Questions per learner (protects the free quota):
# TUTOR_RATE_LIMIT_PER_MINUTE=6
# TUTOR_RATE_LIMIT_PER_DAY=100

# ── Speech & conversation (Phase 7) ──────────────────────────
# Nothing new is REQUIRED: with LLM_PROVIDER=gemini the same GEMINI_API_KEY is used for
#   • speech-to-text  (Gemini listens to the learner's WAV recording)
#   • text-to-speech  (Gemini TTS; each phrase is generated once and cached in the database)
#   • AI pronunciation notes (experimental) and the role-play partner.
# Check everything with:  npm run speech:check -w backend   (-- --models lists the audio models)
# Speech-to-text provider: gemini | groq (Whisper, needs GROQ_API_KEY) | mock (test double).
# Default: the same as LLM_PROVIDER.
# STT_PROVIDER=gemini
# STT_MODEL=
# Text-to-speech: gemini | browser (no server audio; the learner's browser voice) | mock.
# Default: gemini when LLM_PROVIDER=gemini.
# TTS_PROVIDER=gemini
# Optional: a specific TTS model (default: the newest "flash … tts" model your key can use)
# TTS_MODEL=
# TTS_VOICE=Kore
# SPEECH_TIMEOUT_MS=30000
# AI pronunciation notes (a second Gemini call per attempt). false = text + timing feedback only.
# PRONUNCIATION_NOTES=true
# Per-learner limits (protect the free quota):
# SPEECH_RATE_LIMIT_PER_MINUTE=10
# SPEECH_RATE_LIMIT_PER_DAY=150
# CONVERSATION_RATE_LIMIT_PER_MINUTE=8
# CONVERSATION_RATE_LIMIT_PER_DAY=150

# ── Security & admin (Phase 8) ───────────────────────────────
# Brute-force protection: login attempts per (IP + email) per minute (×5 per hour),
# and new accounts per IP per hour.
# LOGIN_RATE_LIMIT_PER_MINUTE=10
# REGISTER_RATE_LIMIT_PER_HOUR=20
# Number of proxies in front of the API (for the learner's real IP in rate limits).
# Default: 0 locally, 1 in production. Vercel /api proxy + Render = 2 (set in render.yaml).
# Docker Compose (frontend proxy → backend) = 1.
# TRUST_PROXY=1
# Admins are NOT configured here: grant the ADMIN role from a terminal that can reach the database:
#   npm run admin:grant -w backend -- you@example.com
