# ─────────────────────────────────────────────────────────────
# Vachan backend environment variables
# Copy this file to backend/.env and fill in your own values:
#     cp backend/.env.example backend/.env
# Never commit backend/.env (it is in .gitignore).
# ─────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development

# Port the Express API listens on. (Not 5000: macOS uses 5000 for AirPlay Receiver.)
PORT=4000

# PostgreSQL connection string:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# The value below matches docker-compose.yml. If you installed PostgreSQL yourself
# (Postgres.app / Homebrew), replace USER and PASSWORD with your own.
DATABASE_URL="postgresql://vachan:vachan_dev_password@localhost:5432/vachan_dev?schema=public"

# Frontend URL(s) allowed to call the API from the browser (comma-separated).
CORS_ORIGIN=http://localhost:3000
