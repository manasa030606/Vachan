// Prisma schema for Vachan.
//
// One set of tables serves ALL languages. Every piece of content belongs to a
// Language row (Hindi, Telugu, …), so adding a seventh language later means
// adding rows, not new tables.
//
//   Language ─┬─ Course ── Unit ── Lesson ─┬─ Exercise ── ExerciseOption
//             │                            └─ VocabularyItem (words introduced, many-to-many)
//             └─ VocabularyItem
//
//   User ── UserProfile
//   User ── UserLessonProgress  (one row per user per lesson)
//   User ── UserExerciseAttempt (one row per submitted answer, from a lesson or a review)
//   User ── UserStats (XP, hearts, streak) · UserDailyActivity (one row per day) · XpEvent (XP log)
//   User ── UserAchievement ── Achievement
//   User ── PlacementTest ── PlacementAnswer ── PlacementQuestion ── Exercise
//
//   Language ── KnowledgeDocument ── KnowledgeChunk (text + metadata + embedding vector)
//   (the RAG knowledge base; the `embedding` column uses the pgvector extension)
//
//   User ── AIConversation ── AIMessage   (AI tutor chats, with the sources of every answer)
//   User ── SpeechAttempt · ConversationSession ── ConversationTurn (speaking practice, role-plays)
//   AdminAuditLog (who changed what in the admin dashboard)
//
// The connection URL is NOT written here. It is read from DATABASE_URL
// in backend/prisma.config.ts (Prisma CLI) and backend/src/lib/prisma.ts (the app).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum UserRole {
  LEARNER
  ADMIN // can use the admin dashboard
}

enum DailyGoal {
  CASUAL
  REGULAR
  SERIOUS
  INTENSE
}

/// The learning-journey stages from the spec (section 4).
enum LearningStage {
  FOUNDATIONS
  FIRST_WORDS
  EVERYDAY_PHRASES
  SENTENCE_BUILDING
  GRAMMAR
  LISTENING
  SPEAKING
  CONVERSATION
  ADVANCED
}

enum LessonKind {
  SCRIPT // letters and sounds
  VOCABULARY // new words
  PHRASES // sentences and phrases
  CHECKPOINT // unit review
}

enum ExerciseType {
  MULTIPLE_CHOICE
  /// Shows a sound ("aa"); the learner picks the matching letter.
  CHARACTER_RECOGNITION
  /// Shows a letter ("ఆ"); the learner picks the sound it makes.
  CHARACTER_SOUND
  MATCHING
  FILL_IN_BLANK
  TRANSLATION
  WORD_ORDER
}

enum VocabularyKind {
  LETTER
  WORD
  PHRASE
}

enum LessonProgressStatus {
  IN_PROGRESS
  COMPLETED
}

/// Why XP was given (see backend/src/config/gamification.ts for the amounts).
enum XpReason {
  EXERCISE_CORRECT
  LESSON_COMPLETED
  LESSON_PRACTICED
  PERFECT_LESSON
  REVIEW_CORRECT
}

/// What a badge counts.
enum AchievementMetric {
  LESSONS_COMPLETED
  TOTAL_XP
  LONGEST_STREAK
  UNITS_COMPLETED
  PERFECT_LESSONS
  MISTAKES_CLEARED
  DAILY_GOALS_MET
}

/// Skill a placement question checks (spec section 3).
enum PlacementSkill {
  SCRIPT
  VOCABULARY
  TRANSLATION
  SENTENCE
}

enum PlacementStatus {
  IN_PROGRESS
  /// All questions answered; a starting unit is recommended.
  COMPLETED
  /// The learner accepted the recommended unit.
  ACCEPTED
  /// The learner chose to start from Unit 1.
  DECLINED
}

/// Where an answer was given: inside a lesson, or in the mistake review.
enum AttemptSource {
  LESSON
  REVIEW
}

// ─────────────────────────────────────────────────────────────
// Users
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// scrypt hash — the plain-text password is NEVER stored.
  passwordHash String
  role         UserRole @default(LEARNER)
  /// Increased on logout. Tokens issued before that stop working.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile          UserProfile?
  lessonProgress   UserLessonProgress[]
  exerciseAttempts UserExerciseAttempt[]
  stats            UserStats?
  dailyActivity    UserDailyActivity[]
  xpEvents         XpEvent[]
  achievements     UserAchievement[]
  placementTests   PlacementTest[]
  aiConversations  AIConversation[]
  speechAttempts   SpeechAttempt[]
  conversations    ConversationSession[]
  adminActions     AdminAuditLog[]
}

model UserProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  displayName       String
  /// The language the learner is currently studying (null until onboarding).
  currentLanguageId String?
  /// Interface language. Only English ("en") for now (spec section 3).
  interfaceLanguage String    @default("en")
  learningGoal      String?
  dailyGoal         DailyGoal @default(REGULAR)
  /// Answer to the onboarding self-assessment question.
  selfAssessment    String?
  showRomanization  Boolean   @default(true)
  soundEffects      Boolean   @default(true)
  onboardingDone    Boolean   @default(false)
  /// IANA time zone from the browser (e.g. "Asia/Kolkata"); decides where a "day" starts for streaks.
  timeZone          String    @default("Asia/Kolkata")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentLanguage Language? @relation(fields: [currentLanguageId], references: [id], onDelete: SetNull)
}

// ─────────────────────────────────────────────────────────────
// Learning content (language-agnostic)
// ─────────────────────────────────────────────────────────────

model Language {
  id          String  @id @default(cuid())
  /// ISO 639-1 code: hi, te, ta, ml, kn, bn
  code        String  @unique
  name        String
  nativeName  String
  scriptName  String
  description String
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  courses            Course[]
  vocabulary         VocabularyItem[]
  learners           UserProfile[]
  placementQuestions PlacementQuestion[]
  placementTests     PlacementTest[]
  knowledgeDocuments KnowledgeDocument[]
  knowledgeChunks    KnowledgeChunk[]
  aiConversations    AIConversation[]
  audioClips         AudioClip[]
  speechAttempts     SpeechAttempt[]
  conversations      ConversationSession[]
}

model Course {
  id          String  @id @default(cuid())
  languageId  String
  title       String
  description String
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  units    Unit[]

  @@index([languageId])
}

model Unit {
  id          String        @id @default(cuid())
  courseId    String
  title       String
  description String
  stage       LearningStage
  sortOrder   Int
  /// Hidden from learners while false (unpublished in the admin dashboard)
  isPublished Boolean       @default(true)

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([courseId, sortOrder])
}

model Lesson {
  id          String     @id @default(cuid())
  unitId      String
  title       String
  /// Short text shown on the lesson intro screen.
  introText   String
  kind        LessonKind
  sortOrder   Int
  isPublished Boolean    @default(true)

  unit            Unit                 @relation(fields: [unitId], references: [id], onDelete: Cascade)
  exercises       Exercise[]
  /// Words/letters introduced at the start of the lesson.
  vocabulary      VocabularyItem[]
  progress        UserLessonProgress[]
  aiConversations AIConversation[]

  @@unique([unitId, sortOrder])
}

model Exercise {
  id             String       @id @default(cuid())
  lessonId       String
  type           ExerciseType
  sortOrder      Int
  /// e.g. "Select the correct meaning"
  instruction    String
  /// The main thing shown to the learner: a word, a letter, or an English sentence.
  prompt         String
  promptSubtext  String?
  /// FILL_IN_BLANK only: sentence text before/after the blank, and its meaning.
  sentenceBefore String?
  sentenceAfter  String?
  translation    String?
  /// Short teaching note shown AFTER the learner answers (never sent before).
  explanation    String?

  lesson             Lesson                @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  options            ExerciseOption[]
  attempts           UserExerciseAttempt[]
  placementQuestions PlacementQuestion[]

  @@unique([lessonId, sortOrder])
}

/// One row per answer choice. How the fields are used depends on the exercise type:
///   MULTIPLE_CHOICE / CHARACTER_RECOGNITION / CHARACTER_SOUND / FILL_IN_BLANK → `isCorrect` marks the right option
///   TRANSLATION → every row is an accepted answer (`isCorrect` = true), never sent to the browser
///   WORD_ORDER  → each row is a word; `correctPosition` is its place in the sentence (null = distractor)
///   MATCHING    → each row is a pair: `text` (left) ↔ `matchText` (right)
model ExerciseOption {
  id              String  @id @default(cuid())
  exerciseId      String
  text            String
  subtext         String?
  isCorrect       Boolean @default(false)
  correctPosition Int?
  matchText       String?
  /// Order in which the option is displayed.
  sortOrder       Int

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
}

model VocabularyItem {
  id           String         @id @default(cuid())
  languageId   String
  kind         VocabularyKind @default(WORD)
  /// The word/letter in its native script, e.g. "నమస్కారం"
  script       String
  romanization String
  meaning      String
  topic        String

  language       Language        @relation(fields: [languageId], references: [id], onDelete: Cascade)
  lessons        Lesson[]
  speechAttempts SpeechAttempt[]

  @@unique([languageId, script])
}

// ─────────────────────────────────────────────────────────────
// Learner progress
// ─────────────────────────────────────────────────────────────

/// One row per learner per lesson. Created when the lesson is started.
/// COMPLETED stays COMPLETED when the learner practises the lesson again.
model UserLessonProgress {
  id                String               @id @default(cuid())
  userId            String
  lessonId          String
  status            LessonProgressStatus @default(IN_PROGRESS)
  startedAt         DateTime             @default(now())
  /// Start of the current run through the lesson. Resuming keeps it; "practise again" resets it.
  runStartedAt      DateTime             @default(now())
  /// Last time the learner started or answered something in this lesson.
  lastActivityAt    DateTime             @default(now())
  completedAt       DateTime?
  /// How many times every exercise was finished in one run (first completion = 1).
  timesCompleted    Int                  @default(0)
  /// Lesson answers only (review answers are not counted here).
  correctAttempts   Int                  @default(0)
  incorrectAttempts Int                  @default(0)
  /// correctAttempts / all attempts, 0–100 (null until the first answer).
  accuracy          Int?
  /// Unlocked by the placement test, not actually studied (doesn't count for stats or badges).
  placedOut         Boolean              @default(false)
  updatedAt         DateTime             @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, lastActivityAt])
}

model UserExerciseAttempt {
  id         String        @id @default(cuid())
  userId     String
  exerciseId String
  /// Copied from the exercise so lesson progress can be calculated with one query.
  lessonId   String
  /// The learner's answer exactly as submitted (JSON).
  answer     Json
  isCorrect  Boolean
  source     AttemptSource @default(LESSON)
  createdAt  DateTime      @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId])
  @@index([userId, exerciseId])
  /// For analytics: attempts in a date range ("last 30 days")
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Gamification — amounts and limits live in backend/src/config/gamification.ts
// ─────────────────────────────────────────────────────────────

/// One row per learner: XP, hearts and streak.
model UserStats {
  id              String   @id @default(cuid())
  userId          String   @unique
  totalXp         Int      @default(0)
  /// Hearts as last saved; refills are added on read (see hearts.ts).
  hearts          Int      @default(5)
  heartsUpdatedAt DateTime @default(now())
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  /// Learner's local date (YYYY-MM-DD) of the last day that counted for the streak.
  lastActiveDate  String?
  perfectLessons  Int      @default(0)
  mistakesCleared Int      @default(0)
  dailyGoalsMet   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One row per learner per LOCAL day with activity (daily goal + streak calendar).
model UserDailyActivity {
  id                String  @id @default(cuid())
  userId            String
  /// Learner's local date, YYYY-MM-DD.
  date              String
  xpEarned          Int     @default(0)
  exercisesAnswered Int     @default(0)
  lessonsCompleted  Int     @default(0)
  goalMet           Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  /// For analytics: active learners per day
  @@index([date])
}

/// Every XP award, so totals can always be explained.
model XpEvent {
  id         String   @id @default(cuid())
  userId     String
  amount     Int
  reason     XpReason
  lessonId   String?
  exerciseId String?
  /// Learner's local date (YYYY-MM-DD) when it was earned.
  localDate  String
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A badge (seeded from backend/src/config/achievements.ts).
model Achievement {
  id          String            @id @default(cuid())
  code        String            @unique
  title       String
  description String
  icon        String
  metric      AchievementMetric
  threshold   Int
  sortOrder   Int               @default(0)

  unlockedBy UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

// ─────────────────────────────────────────────────────────────
// Placement test
// ─────────────────────────────────────────────────────────────

/// A placement question re-uses a course exercise; `unitNumber` is the unit it checks.
model PlacementQuestion {
  id         String         @id @default(cuid())
  languageId String
  exerciseId String
  unitNumber Int
  skill      PlacementSkill
  sortOrder  Int

  language Language          @relation(fields: [languageId], references: [id], onDelete: Cascade)
  exercise Exercise          @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  answers  PlacementAnswer[]

  @@unique([languageId, sortOrder])
}

model PlacementTest {
  id              String          @id @default(cuid())
  userId          String
  languageId      String
  status          PlacementStatus @default(IN_PROGRESS)
  /// Self-assessment answer at the time of the test.
  selfAssessment  String?
  correctCount    Int?
  recommendedUnit Int?
  chosenUnit      Int?
  startedAt       DateTime        @default(now())
  completedAt     DateTime?
  decidedAt       DateTime?

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  language Language          @relation(fields: [languageId], references: [id], onDelete: Cascade)
  answers  PlacementAnswer[]

  @@index([userId, languageId])
}

model PlacementAnswer {
  id         String   @id @default(cuid())
  testId     String
  questionId String
  answer     Json
  isCorrect  Boolean
  createdAt  DateTime @default(now())

  test     PlacementTest     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question PlacementQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([testId, questionId])
}

// ─────────────────────────────────────────────────────────────
// RAG knowledge base
// ─────────────────────────────────────────────────────────────
//
// Content (backend/knowledge-base/*.md + course vocabulary)
//   → cleaning → chunking → embeddings → KnowledgeChunk rows → vector search.
// Rows are written ONLY by `npm run rag:index`; never edit them by hand.

/// Who the chunk is written for. Retrieval prefers the learner's level and below.
enum KnowledgeLevel {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
}

enum KnowledgeContentType {
  ALPHABET
  PRONUNCIATION
  VOCABULARY
  GRAMMAR
  EXAMPLE
  PHRASE
  VERB_FORM
  IDIOM
  CULTURE
  EXPLANATION
}

/// The learner skill a chunk helps with.
enum KnowledgeSkill {
  SCRIPT
  PRONUNCIATION
  VOCABULARY
  GRAMMAR
  CONVERSATION
  CULTURE
}

/// One source document, e.g. backend/knowledge-base/te/phrases.md.
enum KnowledgeOrigin {
  FILE
  COURSE
  ADMIN
}

enum KnowledgeStatus {
  DRAFT
  PUBLISHED
}

model KnowledgeDocument {
  /// Stable id, e.g. "te/phrases" or "course/te/vocabulary"
  id             String                @id
  languageCode   String
  title          String
  /// Where the content comes from, e.g. "Vachan curated notes"
  source         String
  /// File path (or course reference) of the original content
  reference      String
  /// Hash of the cleaned document: unchanged documents are skipped when re-indexing
  contentHash    String
  chunkCount     Int
  indexedAt      DateTime              @default(now())
  // Content management (admin dashboard)
  /// FILE = backend/knowledge-base/*.md (text edited in git) · COURSE = course vocabulary ·
  /// ADMIN = written in the admin dashboard (text stored in `body`)
  origin         KnowledgeOrigin       @default(FILE)
  /// DRAFT documents have no chunks, so search and the AI never see them
  status         KnowledgeStatus       @default(PUBLISHED)
  /// ADMIN documents: the markdown sections ("## Heading" + text)
  body           String?
  /// ADMIN documents: metadata defaults for every section
  level          KnowledgeLevel?
  topic          String?
  contentType    KnowledgeContentType?
  skill          KnowledgeSkill?
  /// The text changed after the last indexing — re-index to update search
  needsReindex   Boolean               @default(false)
  lastIndexError String?
  updatedAt      DateTime              @default(now()) @updatedAt

  language Language         @relation(fields: [languageCode], references: [code], onDelete: Cascade)
  chunks   KnowledgeChunk[]

  @@index([languageCode])
}

/// One retrievable piece of knowledge (usually one section = one concept).
model KnowledgeChunk {
  /// Stable id, e.g. "te/phrases#hello-namaskaram" (or "...#part-2" when a section was split)
  id             String                      @id
  documentId     String
  languageCode   String
  level          KnowledgeLevel
  /// Short slug such as "greetings", "pronouns", "vowels"
  topic          String
  skill          KnowledgeSkill
  contentType    KnowledgeContentType
  source         String
  /// File + section anchor, e.g. "backend/knowledge-base/te/phrases.md#hello-namaskaram"
  reference      String
  /// Section heading, e.g. "Hello — నమస్కారం (namaskaaram)"
  heading        String
  /// Clean text shown to learners and given to the AI tutor
  content        String
  charCount      Int
  contentHash    String
  /// Name of the model that produced `embedding` (vectors from different models can't be compared)
  embeddingModel String
  /// 384-dimension vector from multilingual-e5-small (pgvector type, written with raw SQL)
  embedding      Unsupported("vector(384)")?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  language Language          @relation(fields: [languageCode], references: [code], onDelete: Cascade)

  @@index([languageCode, level])
  @@index([languageCode, topic])
  @@index([documentId])
}

// ─────────────────────────────────────────────────────────────
// AI tutor
// ─────────────────────────────────────────────────────────────
//
// question → RAG retrieval → prompt with the retrieved notes → LLM → answer + references.
// Every assistant message stores the notes it was based on, so answers can always be traced back.

enum AIMessageRole {
  USER
  ASSISTANT
}

enum AIAnswerStatus {
  ANSWERED // grounded answer that cites at least one retrieved note
  INSUFFICIENT // the knowledge base doesn't cover the question → no guessing
  REFUSED // off-topic or a prompt-injection attempt
}

/// One tutor chat. Belongs to one learner and one target language.
model AIConversation {
  id           String   @id @default(cuid())
  userId       String
  languageCode String
  /// First question, shortened — shown in the conversation list
  title        String
  /// Lesson the learner was in when the chat started (optional)
  lessonId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  language Language    @relation(fields: [languageCode], references: [code], onDelete: Cascade)
  lesson   Lesson?     @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  messages AIMessage[]

  @@index([userId, updatedAt])
}

/// One message in a tutor chat (the learner's question or the tutor's answer).
model AIMessage {
  id             String          @id @default(cuid())
  conversationId String
  role           AIMessageRole
  content        String
  /// Tutor answers only: what happened
  status         AIAnswerStatus?
  /// Tutor answers only: the retrieved notes shown as references [{ n, id, heading, source, reference, … }]
  references     Json?
  /// Tutor answers only: examples quoted from the notes [{ native, romanization, meaning }]
  examples       Json?
  /// Tutor answers only: the context used — level, unit, lesson, retrieval query, best similarity…
  context        Json?
  /// Tutor answers only: "gemini/gemini-3.8-flash" (null when no LLM was called)
  model          String?
  latencyMs      Int?
  createdAt      DateTime        @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Speaking & conversation
// ─────────────────────────────────────────────────────────────
//
// Listening:  phrase → text-to-speech (cached in AudioClip) → play / replay / slow.
// Speaking:   expected phrase → recording → speech-to-text → transcript → comparison → feedback.
// Role-play:  scenario + level + vocabulary + RAG notes → AI partner → learner replies → summary.
//
// Learner recordings are NOT stored — only facts about them (length, size, format, timing).

/// Where a recording came from.
enum AudioInputSource {
  RECORDED // the microphone in the app
  UPLOADED // an audio file the learner chose
}

enum ConversationScenario {
  INTRODUCTIONS
  RESTAURANT
  SHOPPING
  TRAVEL
  DIRECTIONS
  EVERYDAY
}

enum ConversationStatus {
  ACTIVE
  ENDED
}

/// How the learner gave a conversation reply.
enum ConversationInputMode {
  TEXT
  VOICE
}

/// Text-to-speech cache: each phrase is generated once (free-tier quota) and served from here.
model AudioClip {
  id           String   @id @default(cuid())
  /// sha256(provider/model/voice + language + text) — the same text never generates twice
  cacheKey     String   @unique
  languageCode String
  text         String
  /// "gemini/<model>/<voice>"
  provider     String
  mimeType     String
  sampleRate   Int
  durationMs   Int
  byteSize     Int
  /// The audio file itself (WAV, usually 50–200 KB)
  data         Bytes
  hits         Int      @default(0)
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  language Language @relation(fields: [languageCode], references: [code], onDelete: Cascade)

  @@index([languageCode])
}

/// One speaking-exercise attempt: what was expected, what speech-to-text heard, and the feedback.
model SpeechAttempt {
  id                   String           @id @default(cuid())
  userId               String
  languageCode         String
  /// The course word/phrase practised (null when a custom text was given)
  vocabularyItemId     String?
  expectedText         String
  expectedRomanization String
  transcript           String
  /// Content match: 0–100 character similarity and its verdict (match, close, partial, different, nothing-heard)
  contentScore         Int
  contentVerdict       String
  /// Word-by-word comparison [{ expected, heard, status, similarity }] + extra words
  contentMatch         Json
  /// Timing-based fluency { rating, pauses, longestPauseMs, lettersPerSecond, notes }
  fluency              Json
  /// AI pronunciation notes { supported, notes, overall, confident } (experimental)
  pronunciation        Json?
  /// Warnings about the recording (too quiet, noisy, distorted)
  audioIssues          Json?
  // ── audio metadata (the recording itself is not stored) ──
  audioSource          AudioInputSource
  audioMimeType        String
  audioBytes           Int
  audioDurationMs      Int
  audioSampleRate      Int
  /// Time with sound in the recording
  speechMs             Int
  /// "gemini/gemini-3.5-flash", "groq/whisper-large-v3" …
  sttModel             String
  latencyMs            Int
  createdAt            DateTime         @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  language       Language        @relation(fields: [languageCode], references: [code], onDelete: Cascade)
  vocabularyItem VocabularyItem? @relation(fields: [vocabularyItemId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

/// One role-play conversation (e.g. ordering at a restaurant in Telugu).
model ConversationSession {
  id           String               @id @default(cuid())
  userId       String
  languageCode String
  scenario     ConversationScenario
  level        KnowledgeLevel
  status       ConversationStatus   @default(ACTIVE)
  /// Number of learner replies so far
  learnerTurns Int                  @default(0)
  /// End-of-session summary { stats, strengths, practise, usefulPhrases } (set when ended)
  summary      Json?
  startedAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  endedAt      DateTime?

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  language Language           @relation(fields: [languageCode], references: [code], onDelete: Cascade)
  turns    ConversationTurn[]

  @@index([userId, startedAt])
}

/// One line in a role-play: the AI partner's line or the learner's reply.
model ConversationTurn {
  id           String                 @id @default(cuid())
  sessionId    String
  role         AIMessageRole
  /// The line in the target language (native script)
  text         String
  romanization String?
  translation  String?
  /// Learner turns: typed or spoken (then text = the transcript the learner sent)
  inputMode    ConversationInputMode?
  /// Learner turns: voice metadata { durationMs, bytes, sttModel } (no audio stored)
  audio        Json?
  /// Learner turns: the partner's feedback { understood, correction, note }
  feedback     Json?
  /// AI turns: reply ideas for the learner [{ text, romanization, meaning }]
  suggestions  Json?
  /// AI turns: the knowledge-base notes used [{ id, heading, reference }]
  references   Json?
  /// AI turns: ANSWERED, or REFUSED when the learner's reply was a prompt-injection attempt
  status       AIAnswerStatus?
  /// AI turns: what the reply was based on — retrieval query, best similarity, level, word coverage
  context      Json?
  model        String?
  latencyMs    Int?
  createdAt    DateTime               @default(now())

  session ConversationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// Admin
// ─────────────────────────────────────────────────────────────

/// Every change made in the admin dashboard: who, what, when (no learner data).
model AdminAuditLog {
  id         String   @id @default(cuid())
  /// The admin who made the change (null if that account was deleted later)
  userId     String?
  /// e.g. "lesson.update", "lesson.publish", "knowledge.reindex"
  action     String
  entityType String
  entityId   String
  /// Short human-readable description, e.g. "Greetings (te-u3-l1)"
  summary    String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
}
